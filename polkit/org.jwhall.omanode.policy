<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omanode (jwhall.omanode) Omarchy plugin</vendor>

  <!--
    Scopes pkexec to this plugin's backend.sh only — without this policy,
    pkexec falls back to the generic "run an arbitrary command as root"
    action, which always prompts and looks alarming.

    allow_active=yes: an active local graphical session may run the backend
    without a password, the same trust level NetworkManager's own polkit
    rules give an active session for network control. This is required in
    practice, not just convenience — the panel's status poll re-invokes the
    backend every refreshIntervalSec, and a password prompt on every tick
    would make the widget unusable.

    Install path: see README.md ("Install" section) — this file must be
    copied to /usr/share/polkit-1/actions/ by the user (root is required to
    write there, so this plugin cannot do it for itself).
  -->
  <action id="org.jwhall.omanode.run-backend">
    <description>Manage ZeroTier network membership</description>
    <message>Authentication is required to manage ZeroTier networks</message>
    <icon_name>network-wired</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PLUGIN_DIR@/backend.sh</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
