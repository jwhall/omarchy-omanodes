<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Omanodes (jwhall.omanodes) Omarchy plugin</vendor>

  <!--
    Scopes pkexec to a single fixed backend script — without this policy,
    pkexec falls back to the generic "run an arbitrary command as root"
    action, which always prompts and looks alarming.

    allow_active=yes: an active local graphical session may run the backend
    without a password, the same trust level NetworkManager's own polkit
    rules give an active session for network control. This is required in
    practice, not just convenience — the panel's status poll re-invokes the
    backend every refreshIntervalSec, and a password prompt on every tick
    would make the widget unusable.

    exec.path deliberately points at a root-owned copy installed to
    /usr/lib/omanodes/backend.sh, NOT at the plugin's own checkout under
    ~/.config/omarchy/plugins/. allow_active=yes vouches only for physical
    presence at the session, not for administrative trust — pointing this
    at anything the authorized (non-admin) user can write would let that
    user edit the target and have it run as root on the next poll. See
    https://github.com/HANCORE-linux/omarchy-plugin-marketplace/issues/356
    for the finding this fixed.

    Install path: see README.md ("Install" section) — both this file and
    the backend copy it points to must be installed by the user (root is
    required to write to either location, so this plugin cannot do it for
    itself).
  -->
  <action id="org.jwhall.omanodes.run-backend">
    <description>Manage ZeroTier network membership</description>
    <message>Authentication is required to manage ZeroTier networks</message>
    <icon_name>network-wired</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/omanodes/backend.sh</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
